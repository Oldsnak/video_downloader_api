APP_NAME=video_downloader_api
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

ALLOWED_DOMAINS=["youtube.com","youtu.be","instagram.com","facebook.com","fb.watch","tiktok.com","pornhub.com","xhamster.com","xnxx.com","xvideos.com","desitales2.com","darkero.com"]

DOWNLOAD_DIR=downloads
MAX_CONCURRENT_DOWNLOADS=1
MAX_FILE_SIZE_MB=2000
DELETE_FILE_AFTER_STREAM=true

DATABASE_URL=sqlite:///./video_downloader.db

# Codespaces test mode: downloads run inside the API process (no Redis/Celery needed).
CELERY_TASK_ALWAYS_EAGER=true
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

YTDLP_TRY_BROWSER_COOKIES=false
YTDLP_INSTAGRAM_COOKIES_FILE=cookies/instagram.txt
YTDLP_YOUTUBE_COOKIES_FILE=cookies/youtube.txt
YTDLP_PORNHUB_COOKIES_FILE=cookies/pornhub.txt
YTDLP_COOKIES_FILE=cookies/instagram.txt

# Proxy credentials are injected at start from Codespaces secrets (YTDLP_PROXY_USER,
# YTDLP_PROXY_PASSWORD, YTDLP_PROXY_ENDPOINTS). Do not put passwords in this file.
